OFFERS_CACHE_TTL=300
LOG_LEVEL=INFO
CAMPAIGNS_CACHE_TTL=30
# Домены, группы кампаний и источники: кэш в памяти процесса, секунды
REFERENCE_CACHE_TTL=300
