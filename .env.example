KEITARO_API_KEY=
KEITARO_DOMAIN_ID=1813
KEITARO_GROUP_ID=10332
KEITARO_TRAFFIC_SOURCE_ID=836
# Префикс имён кампаний (test_<фамилия>_)
CAMPAIGN_PREFIX=test_bykov_
